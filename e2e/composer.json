{
    "name": "workshop/e2e",
    "description": "Браузерные характеризационные тесты раздела «Вакансии». Отдельный проект: с ядром Битрикса не связан, ходит на сайт по HTTP как пользователь.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-sockets": "*"
    },
    "require-dev": {
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
